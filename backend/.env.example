# 复制为 .env 后使用。生产环境只在前端设置里配置 API key，此处留空。
DEBUG=true

# 管理员密码（首启修改）
ADMIN_PASSWORD=change-me

# JWT
JWT_SECRET=opsmind-dev-change-me-please-32chars!!
JWT_EXPIRE_MINUTES=720

# PG + pgvector（业务 + 向量一体）
DATABASE_URL=postgresql+psycopg://opsmind:opsmind@localhost:5432/opsmind

# Redis（可选，不配则内存缓存/降级）
# REDIS_URL=

# LLM（前端设置可覆盖；此处仅开发兜底）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-max
LIGHT_MODEL=qwen-max

# 运行参数（默认即可按需调整）
LLM_SEMAPHORE=5
REPORT_GEN_CONCURRENCY=4
SCRIPT_EXEC_CONCURRENCY=5